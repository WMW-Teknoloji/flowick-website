{
  "name": "flowick-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run prerender",
    "prerender": "esbuild scripts/prerender.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/flowick-prerender.cjs --log-level=warning && node node_modules/.cache/flowick-prerender.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9",
    "wrangler": "^4.107.1"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.4"
  }
}
